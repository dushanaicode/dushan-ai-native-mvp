*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
/dushan-admin-backend/poetry.lock text eol=lf
/dushan-admin-backend/framework/starter_captcha/resources/provenance.json text eol=lf
/dushan-admin-backend/framework/starter_ip/resources/area-manifest.json text eol=lf

# Preserve the exact bytes verified by the IP resource manifests.
/dushan-admin-backend/framework/starter_ip/resources/area.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/dushan-admin-backend/framework/starter_ip/resources/AREA-LICENSE.txt -text
/dushan-admin-backend/framework/starter_ip/resources/ip2region/v3.17.0/manifest.json -text
/dushan-admin-backend/framework/starter_ip/resources/ip2region/v3.17.0/LICENSE.md -text

# Preserve the vendored font license, including its upstream trailing space.
/dushan-admin-backend/framework/starter_captcha/resources/OFL.txt -text whitespace=-blank-at-eol

# Linux container entrypoints must not inherit Windows checkout line endings.
*.sh text eol=lf
